  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "vllm"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "vllm"
        },
        "annotations": {
          "prometheus.io/path": "/metrics",
          "prometheus.io/port": "8000",
          "prometheus.io/scrape": "true"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "model",
            "hostPath": {
              "path": "/var/lib/crossscale-model-cache",
              "type": "DirectoryOrCreate"
            }
          },
          {
            "name": "model-bootstrap",
            "configMap": {
              "name": "vllm-model-bootstrap-k59ktkfthh",
              "defaultMode": 420
            }
          },
          {
            "name": "shm",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "4Gi"
            }
          }
        ],
        "initContainers": [
          {
            "name": "download-model",
            "image": "public.ecr.aws/aws-cli/aws-cli:2.36.17",
            "command": [
              "/bin/sh",
              "/model-bootstrap/download-model.sh"
            ],
            "env": [
              {
                "name": "MODEL_BUCKET",
                "value": "huggingface-model-registry-646821141010-us-east-1"
              },
              {
                "name": "MODEL_PREFIX",
                "value": "inference/meta-llama/Llama-3.1-8B-Instruct"
              },
              {
                "name": "AWS_DEFAULT_REGION",
                "value": "us-east-1"
              },
              {
                "name": "AWS_EC2_METADATA_DISABLED",
                "value": "true"
              },
              {
                "name": "MODEL_CACHE_ENABLED",
                "value": "1"
              }
            ],
            "resources": {
              "limits": {
                "ephemeral-storage": "40Gi",
                "memory": "1Gi"
              },
              "requests": {
                "cpu": "1",
                "ephemeral-storage": "20Gi",
                "memory": "512Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "model",
                "mountPath": "/models"
              },
              {
                "name": "model-bootstrap",
                "readOnly": true,
                "mountPath": "/model-bootstrap"
              }
            ],
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "imagePullPolicy": "IfNotPresent"
          }
        ],
        "containers": [
          {
            "name": "vllm",
            "image": "vllm/vllm-openai:v0.28.0-cu129-ubuntu2404@sha256:56b291b6179fe5e6e6ad5c509d362e745280ccdbe81ecbc0f5155b1cab0ebfc5",
            "args": [
              "/models/llama",
              "--served-model-name",
              "meta-llama/Llama-3.1-8B-Instruct",
              "--max-model-len",
              "32768",
              "--max-num-seqs",
              "4",
              "--max-num-batched-tokens",
              "1024",
              "--enable-chunked-prefill",
              "--no-enable-prefix-caching",
              "--gpu-memory-utilization",
              "0.90",
              "--enforce-eager"
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 8000,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "TRANSFORMERS_OFFLINE",
                "value": "1"
              }
            ],
            "resources": {
              "limits": {
                "ephemeral-storage": "40Gi",
                "memory": "12Gi",
                "nvidia.com/gpu": "1"
              },
              "requests": {
                "cpu": "2",
                "ephemeral-storage": "20Gi",
                "memory": "10Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "volumeMounts": [
              {
                "name": "shm",
                "mountPath": "/dev/shm"
              },
              {
                "name": "model",
                "readOnly": true,
                "mountPath": "/models"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/health",
                "port": "http",
                "scheme": "HTTP"
              },
              "timeoutSeconds": 1,
              "periodSeconds": 1,
              "successThreshold": 1,
              "failureThreshold": 3
            },
            "startupProbe": {
              "httpGet": {
                "path": "/health",
                "port": "http",
                "scheme": "HTTP"
              },
              "timeoutSeconds": 1,
              "periodSeconds": 5,
              "successThreshold": 1,
              "failureThreshold": 180
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "imagePullPolicy": "IfNotPresent"
          }
        ],
        "restartPolicy": "Always",
        "terminationGracePeriodSeconds": 30,
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "node.kubernetes.io/instance-type": "g5.xlarge"
        },
        "serviceAccountName": "vllm-model-reader",
        "serviceAccount": "vllm-model-reader",
        "securityContext": {},
        "schedulerName": "default-scheduler",
        "tolerations": [
          {
            "key": "nvidia.com/gpu",
            "operator": "Exists",
            "effect": "NoSchedule"
          }
        ],
        "enableServiceLinks": false
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "revisionHistoryLimit": 10,
