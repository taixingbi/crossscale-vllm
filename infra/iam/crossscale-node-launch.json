{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchOnlyReviewedCpuType",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:646821141010:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:InstanceType": "m5.large"
        },
        "ArnEquals": {
          "ec2:LaunchTemplate": "arn:aws:ec2:us-east-1:646821141010:launch-template/lt-088bf7d7a865a9c40"
        }
      }
    },
    {
      "Sid": "UseReviewedLaunchResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:646821141010:launch-template/lt-088bf7d7a865a9c40",
        "arn:aws:ec2:us-east-1:646821141010:subnet/subnet-0224d57cacfecbbb1",
        "arn:aws:ec2:us-east-1:646821141010:subnet/subnet-0dfd48124c95efe1b",
        "arn:aws:ec2:us-east-1:646821141010:security-group/sg-013f007544002ef8a",
        "arn:aws:ec2:us-east-1:646821141010:network-interface/*",
        "arn:aws:ec2:us-east-1:646821141010:volume/*",
        "arn:aws:ec2:us-east-1::image/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnEquals": {
          "ec2:LaunchTemplate": "arn:aws:ec2:us-east-1:646821141010:launch-template/lt-088bf7d7a865a9c40"
        }
      }
    }
  ]
}
